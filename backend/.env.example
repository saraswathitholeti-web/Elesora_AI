APP_NAME="ELEYSORA AI"
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Database URL: Supports SQLite for zero-config local development, or Supabase/PostgreSQL for production
# Local SQLite default: sqlite+aiosqlite:///./eleysora.db
# Supabase PostgreSQL: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./eleysora.db

# Supabase Auth & Storage (Optional for offline dev, required for full production auth sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=eleysora-documents

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
